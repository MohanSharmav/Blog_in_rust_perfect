# Copy this to .env.prod and fill in real values, then run:
#   scripts/run.sh prod
#
# .env.prod is gitignored — never commit real production secrets.

POSTGRES_USER=blog
POSTGRES_PASSWORD=
POSTGRES_DB=blog

# Used to encrypt stored passwords — pick a long, random value and keep it
# secret; anyone with it can decrypt every stored password (see
# ARCHITECTURE.md § Known limitations).
MAGIC_KEY=

RUST_LOG=info

# Host port the app is published on.
APP_PORT=8080
